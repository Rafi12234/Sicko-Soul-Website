# -----------------------------------------------------------------------------
# SICKO SOUL API — LOCAL DEVELOPMENT
# Copy this file to .env and replace placeholders with your local MySQL values.
# Never commit the real .env file.
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# Prisma CLI uses DATABASE_URL for db pull / migrate commands.
# If your password contains @ : / ? # or %, URL-encode those characters here.
DATABASE_URL="mysql://YOUR_MYSQL_USER:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:3306/sicko_soul"

# Prisma 7 runtime adapter uses these values.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=YOUR_MYSQL_USER
DATABASE_PASSWORD=YOUR_MYSQL_PASSWORD
DATABASE_NAME=sicko_soul
DATABASE_CONNECTION_LIMIT=10

LOG_LEVEL=debug
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15

# Auth
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN=8h

# Cart / checkout
CART_TTL_DAYS=30
DELIVERY_CHARGE_BDT=0

# Email outbox worker
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_INTERVAL_MS=30000
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_LOCK_TIMEOUT_MS=600000
# console = local logging only; resend = real email delivery
EMAIL_TRANSPORT=console
EMAIL_FROM="Sicko Soul <noreply@sickosoul.shop>"
RESEND_API_KEY=

# One-time local SUPER_ADMIN bootstrap.
# Fill these temporarily, run `npm run admin:bootstrap`, then remove the password.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

