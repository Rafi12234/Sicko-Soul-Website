{
  "name": "sicko-soul-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",

    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:status": "prisma migrate status",
    "prisma:baseline:mark": "prisma migrate resolve --applied 0_init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",

    "migrate:production": "node dist/src/scripts/migrate-production.js",

    "admin:bootstrap": "tsx src/scripts/bootstrap-admin.ts",
    "seed:catalog": "tsx src/scripts/seed-catalog.ts",
    "smoke:public": "tsx src/scripts/smoke-public.ts",

    "seed:catalog:prod": "node dist/src/scripts/seed-catalog.js",
    "admin:bootstrap:prod": "node dist/src/scripts/bootstrap-admin.js"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "^3.4.5",
    "pino": "^9.9.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "prisma": "^7.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}